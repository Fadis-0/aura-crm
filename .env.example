# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Bypasses row-level security. Used by the scripts to run
# migrations, create accounts and seed data. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Used by `npm run db:push`. Replace PASSWORD with your database password.
#
# The direct host below is IPv6-only. If it does not resolve on your network,
# use the session-mode pooler instead:
#   postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# The two accounts. Both are owners with equal standing. `npm run db:seed`
# creates them. There is no sign-up page, so these are the only two people who
# can ever get in.
# ---------------------------------------------------------------------------
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-this-to-something-long
OWNER_NAME=Your Name

CO_OWNER_EMAIL=her@example.com
CO_OWNER_PASSWORD=change-this-too
CO_OWNER_NAME=Her Name
